<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.prasunmondal</groupId>
        <artifactId>gridbase-parent</artifactId>
        <version>0.2.0</version>
    </parent>

    <artifactId>gridbase-android</artifactId>
    <packaging>jar</packaging>

    <name>GridBase Android</name>
    <description>
        Android support for GridBase: a response cache on the platform's own SQLite
        (android.database.sqlite), so no native library has to be shipped.
    </description>
    <url>https://github.com/prasunmondal/gridbase</url>

    <dependencies>

        <dependency>
            <groupId>io.github.prasunmondal</groupId>
            <artifactId>gridbase</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Compile-only stubs of the Android framework; the device provides the real classes.
             Everything used here exists since API 16. -->
        <dependency>
            <groupId>com.google.android</groupId>
            <artifactId>android</artifactId>
            <version>4.1.1.4</version>
            <scope>provided</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>animal-sniffer-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
